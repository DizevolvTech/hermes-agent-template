# Exemplo de unit de usuário. Prefira `hermes gateway install/start` se sua versão oferecer.
# Copie para ~/.config/systemd/user/ e ajuste caminhos.
[Unit]
Description=Hermes gateway — {{AGENT_NAME}}
After=network-online.target

[Service]
Environment=HERMES_HOME=%h/.hermes/profiles/{{AGENT_SLUG}}
WorkingDirectory=/caminho/para/{{SLUG}}-casa-{{AGENT_SLUG}}
ExecStart=%h/.local/bin/hermes -p {{AGENT_SLUG}} gateway run
Restart=on-failure

[Install]
WantedBy=default.target
